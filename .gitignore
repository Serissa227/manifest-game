# 构建产物
/target/
**/target/

# 可重建的磁盘航线缓存（打包时生成，见 tools/release/package-installer.ps1）
cache/nav/
*.bin

# 前端依赖与产物
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# 素材管线下载的原始采样与音效包、生成用的原图（体积大，可按 tools/ 下的说明重新取得）
/.tools/
art-src/masters/
__pycache__/

# 存档与本地配置
saves/
*.mfsave
*.mfsave.zst
*.local.toml
.env
.env.*
settings.local.json
crates/manifest-app/gen/

# 编辑器与系统文件
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 测试用的固定版本样例存档需要入库
!crates/manifest-sim/tests/fixtures/*.mfsave.zst

# 细图层（data/maps/<地图>/fine/）是入库的数据，不是缓存
!data/maps/*/fine/*.bin
